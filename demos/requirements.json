  "requirements": [
    {
      "id": "R01",
      "text": "A single 2,000-call chain initially displays a small recent page and loads earlier steps by scrolling upward.",
      "source": "it handles messages by loading more as u scroll up. Ideally I want it to do that for a single tool chain too",
      "command": "bash tests/tool-chain/launch-demo.sh",
      "setup": "python3 tests/tool-chain/backend_fixture.py --port 5191",
      "steps": [
        {
          "wait_for": "DEMO-MARK ready",
          "timeout": 60
        },
        {
          "wait": 2
        },
        {
          "checkpoint": "recent"
        },
        {
          "move": [
            800,
            480
          ]
        },
        {
          "click": [
            800,
            480
          ],
          "button": 5
        },
        {
          "wait": 0.5
        },
        {
          "click": [
            800,
            480
          ],
          "button": 5
        },
        {
          "wait": 0.5
        },
        {
          "click": [
            800,
            480
          ],
          "button": 4
        },
        {
          "wait": 0.5
        },
        {
          "wait": 2
        },
        {
          "checkpoint": "earlier"
        }
      ],
      "checkpoints": [
        {
          "label": "recent",
          "question": "Does the page identify 2,000 retained tool calls while showing approximately 50 recent steps and a Load earlier steps control?",
          "failure": "Thousands of steps are displayed or no paging control appears."
        },
        {
          "label": "earlier",
          "question": "After scrolling upward, has the displayed step count increased and the hidden count decreased while retained calls remain 2,000?",
          "failure": "The displayed count stays unchanged or retained history is reduced."
        }
      ],
      "check": "npm run test:frontend -- --run src/lib/components/chat/Messages/outputWindow.test.ts",
      "timeout": 120
    },
